---
import Icon from './Icon.astro';
import business from '../data/business.json';
import logo from '../assets/images/logo.png';
---
<header class="nav">
  <!-- logo is used exactly as provided: original file, no resizing or re-encoding -->
  <a class="plate" href="#top" aria-label={`${business.name}, back to top`}><img src={logo.src} width={logo.width} height={logo.height} alt={business.name}></a>
  <ul>
    <li><a href="#menu">Menu</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#photos">Photos</a></li>
    <li><a href="#visit">Visit</a></li>
  </ul>
  <a class="btn btn-amber" href={business.links.directions} target="_blank" rel="noopener">
    <Icon name="pin" />
    <span>Get directions</span></a>
</header>

<script>
  // Mark the nav once the hero has scrolled out from under it.
  const nav = document.querySelector<HTMLElement>('.nav');
  const hero = document.querySelector('.hero');
  if (nav && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => nav.classList.toggle('is-past', !e.isIntersecting), { rootMargin: '-96px 0px 0px 0px' }).observe(hero);
  }
</script>

<style is:global>
  .nav{position:fixed;z-index:15;top:20px;left:50%;transform:translateX(-50%);width:min(1240px,calc(100% - 40px));display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:8px 8px 8px 10px;border-radius:999px;background:rgba(20,22,15,.62);border:1px solid var(--line);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transition:background-color .6s cubic-bezier(.22,.61,.36,1),border-color .6s}
  /* past the hero the bar sits over photos and the bone visit card, so it deepens for legibility */
  .nav.is-past{background:rgba(20,22,15,.88);border-color:rgba(236,229,212,.2)}
  .nav .plate{display:flex;background:#fff;border-radius:999px;padding:5px 14px}
  .nav .plate img{height:32px;width:auto}
  .nav ul{list-style:none;display:flex;gap:1.75rem;font-size:.95rem}
  .nav ul a{text-decoration:none;color:var(--bone-dim);transition:color .2s}
  .nav ul a:hover{color:var(--bone)}
  .nav .btn{min-height:44px;padding:.6rem 1.1rem}

  @media (max-width:980px){
    .nav ul{display:none}
  }
  @media (max-width:640px){
    .nav{top:12px;width:calc(100% - 24px)}
    .nav .btn span{display:none}
    .nav .btn{padding:.6rem .8rem}
  }
</style>
