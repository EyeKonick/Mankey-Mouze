---
import { Image, getImage } from 'astro:assets';
import { sections, currency, alsoAtTheBar, drinkCount, countWord } from '../lib/menu';
import frappeBoard from '../assets/images/menu-board-frappe.png';
import nonCoffeeBoard from '../assets/images/menu-board-non-coffee.png';

const boards = {
  frappe: { src: frappeBoard, label: 'frappe', alt: 'The frappe menu board with photos and prices of eight frappes', cap: 'The frappe board' },
  'non-coffee': { src: nonCoffeeBoard, label: 'non-coffee', alt: 'The non-coffee menu board with photos and prices of eight drinks', cap: 'The non-coffee board' },
};
// full-size WebP for the photo viewer (the boards are 361px wide at source; never upscaled)
const full = Object.fromEntries(
  await Promise.all(Object.entries(boards).map(async ([k, b]) => [k, (await getImage({ src: b.src, format: 'webp', quality: 85 })).src]))
);
const boardList = sections.map((s) => ({ key: s.board, ...boards[s.board as keyof typeof boards] }));
---
<section id="menu" class="sec" aria-labelledby="menu-h">
  <div class="wrap">
    <div class="head menu-head">
      <div class="intro">
        <h2 class="big" id="menu-h" data-reveal>What's on the board</h2>
        <p data-reveal>{countWord(drinkCount, true)} iced drinks, priced in pesos and copied from the two boards on the wall, with the main ingredients each board lists. Tap a board to read it full size.</p>
      </div>
      <div class="board-shots">
        {boardList.map((b) => (
          <button type="button" data-reveal data-lb="single" data-full={full[b.key]} data-alt={b.alt} data-cap={b.cap} aria-label={`Open the ${b.label} board full size`}>
            <Image src={b.src} alt={`The ${b.label} menu board`} format="webp" quality={82} widths={[180, 361]} sizes="(max-width: 980px) 45vw, 250px" />
          </button>
        ))}
      </div>
    </div>
    <div class="boards">
      {sections.map((s) => (
        <div class="board">
          <h3 data-reveal>{s.title} <span>{s.note}</span></h3>
          <ul>
            {s.items.map((i) => (
              <li data-reveal><b>{i.name}{i.tag && <> <span class="pill">{i.tag}</span></>}</b><span class="lead"></span><span class="p"><small>{currency}</small>{i.price}</span><span class="ing">{i.ingredients}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="bar-extra" data-reveal>
      <div>
        <h3>{alsoAtTheBar.title}</h3>
        <p>{alsoAtTheBar.text}</p>
      </div>
      <div class="board-thumbs">
        {boardList.map((b) => (
          <button type="button" data-lb="single" data-full={full[b.key]} data-alt={b.alt} data-cap={b.cap}><span>See the {b.label} board</span></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .menu-head{grid-template-columns:minmax(0,1fr) auto;align-items:center}
  .menu-head .intro p{color:var(--bone-dim);max-width:40ch;margin-top:1.2rem}
  .board-shots{display:flex;gap:18px;align-items:flex-start}
  .board-shots button{all:unset;cursor:zoom-in;display:block;width:clamp(150px,17vw,250px);border-radius:6px}
  .board-shots button:nth-child(2){margin-top:48px}
  .board-shots button:focus-visible{outline:2px solid var(--amber);outline-offset:4px}
  .board-shots img{width:100%;height:auto;aspect-ratio:361/510;object-fit:cover;border-radius:6px;-webkit-mask-image:linear-gradient(180deg,#000 62%,transparent 100%);mask-image:linear-gradient(180deg,#000 62%,transparent 100%);transition:transform .6s cubic-bezier(.16,1,.3,1)}
  .board-shots button:hover img{transform:translateY(-4px)}
  .pill{display:inline-block;border-radius:999px;background:var(--sage);color:#1b2213;font-size:.75rem;font-weight:600;padding:.12rem .55rem;line-height:1.5;vertical-align:.12em}

  .boards{display:grid;grid-template-columns:1fr 1fr;gap:72px}
  .board h3{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;font-weight:500;font-size:1.3rem;padding-bottom:14px;border-bottom:1px solid var(--bone)}
  .board h3 span{font-size:.9rem;font-weight:400;color:var(--bone-dim)}
  .board ul{list-style:none}
  .board li{display:grid;grid-template-columns:auto 1fr auto;align-items:baseline;gap:12px;padding:16px 0;border-bottom:1px solid var(--line)}
  .board li b{font-weight:500;font-size:1.06rem}
  .board li .ing{grid-column:1/-1;margin-top:-6px;font-size:.9rem;color:var(--bone-dim)}
  .board li .lead{border-bottom:1px dotted rgba(236,229,212,.28);transform:translateY(-5px)}
  .board li .p{font-variant-numeric:tabular-nums;color:var(--amber);font-weight:500;font-size:1.06rem}
  .board li .p small{font-size:.75em;margin-right:1px;color:var(--bone-dim);font-weight:400}
  .bar-extra{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:32px;align-items:center;margin-top:56px;padding:28px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .bar-extra h3{font-weight:500;font-size:1.15rem}
  .bar-extra p{color:var(--bone-dim);margin-top:.25rem;max-width:56ch}
  .board-thumbs{display:flex;gap:14px}
  .board-thumbs button{all:unset;cursor:pointer;display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid rgba(236,229,212,.32);transition:border-color .2s,background-color .2s}
  .board-thumbs button:hover{border-color:var(--bone-dim);background:rgba(236,229,212,.04)}
  .board-thumbs button:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
  .board-thumbs span{font-size:.92rem;font-weight:500}

  @media (max-width:980px){
    .boards{grid-template-columns:1fr}
    .boards{gap:48px}
    .menu-head{grid-template-columns:1fr}
    .board-shots button{width:calc(50% - 9px)}
    .bar-extra{grid-template-columns:1fr}
  }
  @media (max-width:640px){
    .board-thumbs{flex-wrap:wrap}
  }
</style>
