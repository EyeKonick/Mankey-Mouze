---
import Icon from './Icon.astro';
import business from '../data/business.json';
---
<!-- Phone-only quick actions; slides up once the hero has scrolled away. -->
<nav class="dock" id="dock" aria-label="Quick actions">
  <a class="btn btn-amber" href={business.links.directions} target="_blank" rel="noopener"><Icon name="pin" /> Get directions</a>
  <a class="btn btn-line" href={business.links.facebook} target="_blank" rel="noopener" aria-label="Message us on Facebook"><Icon name="message" /></a>
  <a class="btn btn-line" href={`tel:${business.phone.tel}`} aria-label={`Call ${business.phone.display}`}><Icon name="phone" /></a>
</nav>

<script>
  const dock = document.getElementById('dock');
  const hero = document.querySelector('.hero');
  if (dock && hero) {
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => dock.classList.toggle('show', !es[0].isIntersecting), { threshold: 0.05 }).observe(hero);
    } else {
      dock.classList.add('show');
    }
  }
</script>

<style is:global>
  .dock{display:none}
  @media (max-width:640px){
    .dock{display:grid;grid-template-columns:1fr 52px 52px;gap:8px;position:fixed;z-index:20;left:12px;right:12px;bottom:12px;padding:8px;border-radius:999px;background:rgba(20,22,15,.86);border:1px solid var(--line);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);transform:translateY(140%);visibility:hidden}
    .dock.show{transform:none;visibility:visible}
    .dock .btn{justify-content:center;padding:.6rem}
    @media (prefers-reduced-motion:no-preference){ .dock{transition:transform .45s cubic-bezier(.16,1,.3,1),visibility .45s} }
  }
</style>
