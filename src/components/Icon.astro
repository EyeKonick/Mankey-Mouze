---
/** Authored line icons, one stroke weight (class "i" is styled in global.css). */
interface Props { name: 'pin' | 'message' | 'phone' | 'instagram' | 'arrow' | 'prev' | 'next' | 'close' }
const { name } = Astro.props;
---
<svg class="i" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></>}
  {name === 'message' && <><path d="M12 3C7 3 3 6.7 3 11.3c0 2.5 1.2 4.7 3.1 6.2V21l3-1.7c.9.3 1.9.4 2.9.4 5 0 9-3.7 9-8.4S17 3 12 3z"/><path d="m7.5 13.5 3-3.2 2.5 2.1 3.5-2.9-3 3.3-2.5-2.1z"/></>}
  {name === 'phone' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></>}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8"/>}
  {name === 'prev' && <path d="m15 18-6-6 6-6"/>}
  {name === 'next' && <path d="m9 18 6-6-6-6"/>}
  {name === 'close' && <path d="M18 6 6 18M6 6l12 12"/>}
</svg>
