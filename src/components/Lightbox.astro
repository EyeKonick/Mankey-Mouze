---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import storefront from '../assets/images/storefront.png';
// placeholder until a photo is opened; lazy, so it never loads while the dialog is closed
const initial = await getImage({ src: storefront, format: 'webp', quality: 85 });
---
<!-- One photo viewer for the gallery ([data-lb="gallery"]) and the menu boards ([data-lb="single"]). -->
<dialog class="lb" id="lb" aria-label="Photo viewer">
  <figure>
    <img id="lb-img" src={initial.src} alt="" decoding="async" loading="lazy">
    <figcaption id="lb-cap"></figcaption>
  </figure>
  <div class="ctrl">
    <button type="button" id="lb-prev" aria-label="Previous photo"><Icon name="prev" /></button>
    <button type="button" id="lb-close" aria-label="Close photo viewer"><Icon name="close" /></button>
    <button type="button" id="lb-next" aria-label="Next photo"><Icon name="next" /></button>
  </div>
</dialog>

<script>
  type Shot = { src: string; alt: string; cap: string };
  const read = (b: HTMLElement): Shot => ({ src: b.dataset.full ?? '', alt: b.dataset.alt ?? '', cap: b.dataset.cap ?? '' });

  const lb = document.getElementById('lb') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const cap = document.getElementById('lb-cap') as HTMLElement;
  const prev = document.getElementById('lb-prev') as HTMLButtonElement;
  const next = document.getElementById('lb-next') as HTMLButtonElement;
  const galleryButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-lb="gallery"]'));
  const gallery = galleryButtons.map(read);
  let set: Shot[] = gallery;
  let idx = 0;
  let opener: HTMLElement | null = null;

  const render = () => {
    const s = set[idx];
    img.src = s.src; img.alt = s.alt; cap.textContent = s.cap;
    prev.hidden = next.hidden = set.length < 2;
  };
  const open = (list: Shot[], i: number, from: HTMLElement) => {
    set = list; idx = i; opener = from; render();
    if (typeof lb.showModal === 'function') lb.showModal(); else lb.setAttribute('open', '');
  };
  const step = (d: number) => { idx = (idx + d + set.length) % set.length; render(); };

  document.querySelectorAll<HTMLElement>('[data-lb]').forEach((b) => {
    b.addEventListener('click', () => {
      if (b.dataset.lb === 'gallery') open(gallery, galleryButtons.indexOf(b), b);
      else open([read(b)], 0, b);
    });
  });
  prev.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  document.getElementById('lb-close')?.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (set.length > 1 && e.key === 'ArrowRight') step(1);
    if (set.length > 1 && e.key === 'ArrowLeft') step(-1);
  });
  lb.addEventListener('close', () => opener?.focus());
</script>

<style is:global>
  dialog.lb{margin:auto;border:0;padding:0;background:transparent;max-width:min(1100px,94vw);width:100%;color:var(--bone)}
  dialog.lb::backdrop{background:rgba(10,11,7,.9)}
  .lb figure{display:grid;gap:14px}
  .lb img{max-height:78vh;width:auto;max-width:100%;margin:0 auto;border-radius:6px}
  .lb figcaption{text-align:center;color:var(--bone-dim);font-size:.95rem}
  .lb .ctrl{display:flex;justify-content:center;gap:10px;margin-top:14px}
  .lb .ctrl button{all:unset;cursor:pointer;width:46px;height:46px;border-radius:50%;border:1px solid rgba(236,229,212,.32);display:grid;place-items:center;transition:border-color .2s}
  .lb .ctrl button:hover{border-color:var(--bone)}
  .lb .ctrl button:focus-visible{outline:2px solid var(--amber);outline-offset:3px}
  @media (prefers-reduced-motion:no-preference){ dialog.lb[open]{animation:lbin .35s cubic-bezier(.16,1,.3,1)} @keyframes lbin{from{opacity:0;transform:scale(.97)}to{opacity:1;transform:none}} }
</style>
